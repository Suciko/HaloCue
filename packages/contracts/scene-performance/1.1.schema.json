{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suciko/HaloCue/contracts/scene-performance/1.1.schema.json",
  "title": "HaloCue deterministic scene performance plan",
  "description": "Renderer-independent sampled performance operations compiled from authored scene events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frame_rate", "scene_id", "total_frames", "operations", "source_map"],
  "properties": {
    "schema_version": { "const": "scene-performance/1.1" },
    "frame_rate": { "type": "integer", "minimum": 1, "maximum": 240 },
    "scene_id": { "type": ["string", "null"] },
    "total_frames": { "type": "integer", "minimum": 1 },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/shakeOperation" },
          { "$ref": "#/$defs/numericTweenOperation" }
        ]
      }
    },
    "source_map": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceMapEntry" }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "operationBase": {
      "type": "object",
      "required": ["operation_id", "source_event_id", "kind", "target", "channel", "value_space", "start_frame", "end_frame"]
    },
    "shakeOperation": {
      "allOf": [
        { "$ref": "#/$defs/operationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id", "source_event_id", "kind", "target", "channel", "value_space",
            "start_frame", "end_frame", "amplitude_x_px", "amplitude_y_px", "frequency_hz"
          ],
          "properties": {
            "operation_id": { "$ref": "#/$defs/stableId" },
            "source_event_id": { "$ref": "#/$defs/stableId" },
            "kind": { "const": "shake" },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "target_id"],
              "properties": {
                "kind": { "const": "stage" },
                "target_id": { "const": "stage/global" }
              }
            },
            "channel": { "const": "geometry.offset" },
            "value_space": { "const": "relative-to-baseline" },
            "start_frame": { "type": "integer", "minimum": 0 },
            "end_frame": { "type": "integer", "minimum": 1 },
            "amplitude_x_px": { "type": "number", "minimum": 0, "maximum": 14 },
            "amplitude_y_px": { "type": "number", "minimum": 0, "maximum": 8 },
            "frequency_hz": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 }
          }
        }
      ]
    },
    "numericTweenOperation": {
      "allOf": [
        { "$ref": "#/$defs/operationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id", "source_event_id", "kind", "target", "channel", "value_space",
            "start_frame", "end_frame", "from", "to", "easing"
          ],
          "properties": {
            "operation_id": { "$ref": "#/$defs/stableId" },
            "source_event_id": { "$ref": "#/$defs/stableId" },
            "kind": { "const": "numeric-tween" },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "character_id", "slot"],
              "properties": {
                "kind": { "const": "character" },
                "character_id": { "$ref": "#/$defs/stableId" },
                "slot": { "type": "integer", "minimum": 1, "maximum": 5 }
              }
            },
            "channel": {
              "enum": ["presentation.opacity", "layout.offset-y", "presentation.scale"]
            },
            "value_space": {
              "enum": ["absolute", "relative-to-baseline", "factor-from-baseline"]
            },
            "start_frame": { "type": "integer", "minimum": 0 },
            "end_frame": { "type": "integer", "minimum": 1 },
            "from": { "type": "number" },
            "to": { "type": "number" },
            "easing": { "const": "ease-out-cubic" }
          }
        }
      ]
    },
    "sourceMapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_event_id", "operation_ids", "primary_operation_id"],
      "properties": {
        "source_event_id": { "$ref": "#/$defs/stableId" },
        "operation_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "primary_operation_id": { "$ref": "#/$defs/stableId" }
      }
    }
  }
}
