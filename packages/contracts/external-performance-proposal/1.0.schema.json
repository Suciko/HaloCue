{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External AA performance proposal 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "state",
    "reason",
    "changes"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "pattern": "^prop-[0-9a-f]{12}$"
    },
    "state": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "can_apply_safely": {
      "type": "boolean"
    },
    "duplicate": {
      "type": "boolean"
    },
    "view_path": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card",
          "operation",
          "before",
          "after"
        ],
        "properties": {
          "card": {
            "type": "integer",
            "minimum": 1
          },
          "operation": {
            "enum": [
              "update",
              "insert_after"
            ]
          },
          "before": {
            "type": [
              "object",
              "null"
            ]
          },
          "after": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "minProperties": 1
          }
        }
      }
    }
  }
}
