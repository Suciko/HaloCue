{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halocue.local/contracts/character-reference-resolution-1.0.schema.json",
  "title": "Curated character reference resolution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "available", "added", "reused", "ambiguous", "blocked"],
  "properties": {
    "schema_version": {"const": "character-reference-resolution/1.0"},
    "available": {"type": "boolean"},
    "added": {"type": "array", "items": {"type": "object", "required": ["name", "reference_id", "card_id", "revision_id", "source_hash"], "properties": {"name": {"type": "string"}, "reference_id": {"type": "string"}, "card_id": {"type": "string"}, "revision_id": {"type": "string"}, "source_hash": {"type": "string"}}}},
    "reused": {"type": "array", "items": {"type": "object", "required": ["name", "card_id", "revision_id"], "properties": {"name": {"type": "string"}, "card_id": {"type": "string"}, "revision_id": {"type": "string"}}}},
    "ambiguous": {"type": "array", "items": {"type": "object", "required": ["alias", "candidates"], "properties": {"alias": {"type": "string"}, "candidates": {"type": "array", "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}}}}}},
    "blocked": {"type": "array", "items": {"type": "object", "required": ["name", "reason"], "properties": {"name": {"type": "string"}, "reason": {"type": "string"}}}}
  }
}
