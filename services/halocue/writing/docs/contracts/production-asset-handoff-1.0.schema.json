{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halocue.local/contracts/production-asset-handoff-1.0.schema.json",
  "title": "HaloCue Production Asset Handoff 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "source_set_digest", "references"],
  "properties": {
    "schema_version": {"const": "production-asset-handoff/1.0"},
    "release_id": {"type": "string", "minLength": 1},
    "source_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "references", "digest"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "references": {
            "type": "array",
            "items": {"type": "object"}
          }
        }
      }
    }
  }
}
