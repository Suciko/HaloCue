{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work-owned directed card assistance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "target_id",
    "base_revision_id",
    "allowed_fields"
  ],
  "properties": {
    "schema_version": {
      "const": "card-assistance/1.0"
    },
    "kind": {
      "enum": [
        "character_card",
        "world_card"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "role",
          "voice_anchors",
          "knowledge_boundary",
          "ooc_constraints",
          "relationships",
          "summary",
          "aliases",
          "participants",
          "participant_character_ids",
          "related_world_ids"
        ]
      }
    },
    "name": {
      "type": "string"
    },
    "draft": {
      "type": "object"
    },
    "boundary": {
      "type": "string"
    }
  }
}
