{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halocue.local/contracts/production-asset-usage-1.0.schema.json",
  "title": "HaloCue Production Asset Usage Receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "production_run_id", "references"],
  "properties": {
    "schema_version": {"const": "production-asset-usage/1.0"},
    "production_run_id": {"type": "string", "minLength": 1},
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "reference_id", "source_asset_id", "source_version", "content_hash", "production_copy"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "reference_id": {"type": "string", "minLength": 1},
          "source_asset_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "minLength": 1},
          "production_copy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["copy_id", "content_hash"],
            "properties": {
              "copy_id": {"type": "string", "minLength": 1},
              "content_hash": {"type": "string", "minLength": 1},
              "content_hash_kind": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
